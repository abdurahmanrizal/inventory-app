# Environment and local secrets
.env
.env.*
!.env.example
auth.json

# PHP / Composer dependencies and tooling
/vendor/
.phpunit.result.cache
.phpunit.cache/
/.php-cs-fixer.cache
/coverage/

# JavaScript dependencies and generated assets
/node_modules/
/public/build/
/public/hot
/public/storage
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.tsbuildinfo

# Laravel runtime files
/bootstrap/cache/*.php
/storage/*.key
/storage/app/private/*
/storage/app/public/*
/storage/framework/cache/*
/storage/framework/sessions/*
/storage/framework/testing/*
/storage/framework/views/*
/storage/logs/*

# Keep Laravel runtime directory placeholders
!/storage/app/private/.gitignore
!/storage/app/public/.gitignore
!/storage/framework/cache/.gitignore
!/storage/framework/cache/data/
!/storage/framework/cache/data/.gitignore
!/storage/framework/sessions/.gitignore
!/storage/framework/testing/.gitignore
!/storage/framework/views/.gitignore
!/storage/logs/.gitignore

# Local databases
/database/*.sqlite
/database/*.sqlite-*
/database/*.db

# Temporary files
/tmp/
/temp/
*.tmp
*.temp

# IDE and editor settings
/.idea/
/.vscode/
/.fleet/
/.nova/
/.zed/
*.sublime-project
*.sublime-workspace

# Operating system files
.DS_Store
Thumbs.db
Desktop.ini
